index 0000000..959ffb2
--- /dev/null
+++ b/include/ZceGasSamples.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <stdint.h>
+
+// One validated snapshot per second, with five samples for each ZCE04B gas.
+class ZceGasSamples {
+ public:
+  enum Gas { CO, H2S, O2, CH4, GAS_COUNT };
+  static constexpr uint32_t SAMPLE_INTERVAL_MS = 1000;
+  static constexpr uint8_t SAMPLE_COUNT = 5;
+
+  bool sampleDue(uint32_t nowMs) {
+    if (uint32_t(nowMs - lastSampleMs_) < SAMPLE_INTERVAL_MS) return false;
+    lastSampleMs_ = nowMs;
+    return true;
+  }
+
+  void reset() { next_ = 0; count_ = 0; }
+
+  void add(float co, float h2s, float o2, float ch4) {
+    const float values[GAS_COUNT] = {co, h2s, o2, ch4};
+    for (uint8_t gas = 0; gas < GAS_COUNT; ++gas) samples_[gas][next_] = values[gas];
+    next_ = (next_ + 1) % SAMPLE_COUNT;
+    if (count_ < SAMPLE_COUNT) ++count_;
+  }
+
+  bool ready() const { return count_ == SAMPLE_COUNT; }
+  float average(Gas gas) const {
+    if (count_ == 0) return 0.0f;
+    float total = 0.0f;
+    for (uint8_t i = 0; i < count_; ++i) total += samples_[gas][i];
+    return total / count_;
+  }
+
+ private:
+  float samples_[GAS_COUNT][SAMPLE_COUNT] = {};
+  uint32_t lastSampleMs_ = 0;
+  uint8_t next_ = 0;
+  uint8_t count_ = 0;
+};
